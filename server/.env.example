# ---- Server ----
PORT=5050
NODE_ENV=development
# Comma separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/grievanceai

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- AI Triage ----
# AI_PROVIDER: none | openai | anthropic | gemini
# When set to "none" (or the key is missing) the system uses the explicitly
# labelled rule-based fallback engine. AI integrations are never faked.
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Hard timeout for a single AI request (ms)
AI_TIMEOUT_MS=12000

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# ---- Bootstrap admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@grievanceai.gov
SEED_ADMIN_PASSWORD=Admin@12345
